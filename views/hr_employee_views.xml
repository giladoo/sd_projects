<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sd_projects_view_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.employee.relatives.expiry</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="project_name"/>
            </xpath>
        </field>
    </record>

    <record id="sd_projects_view_employee_filter_inherit" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.filter</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="before">
                <field name="project_name" icon="fa-sitemap" enable_counters="1"/>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="work_location_id" icon="fa-sitemap" enable_counters="1"/>
            </xpath>
        </field>
    </record>

        <menuitem
            id="projects_nemu"
            name="SD Projects"
            parent="hr.menu_config_employee"
            action="sd_projects.project_window_action"/>
</odoo>
