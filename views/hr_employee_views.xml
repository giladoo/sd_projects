<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sd_projects_view_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.employee.relatives.expiry</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div class="oe_button_box" position="inside">
                <button class="oe_stat_button" name="action_projects_view"
                        type="object" icon="fa-sitemap">
                    <field string="Projects" name="projects_count" widget="statinfo"/>
                </button>
            </div>
            <xpath expr="//field[@name='department_id']" position="after">
<!--                <field name="project_name" required="1"/>-->
                <field name="project" domain="[('employee', '=', id)]"
                       context="{'default_employee': id}"
                       options="{'no_create': True, 'no_open': True, }"/>
            </xpath>
        </field>
    </record>

    <record id="sd_projects_view_employee_filter_inherit" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.filter</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
<!--            <xpath expr="//field[@name='department_id']" position="before">-->
<!--                <field name="project_name" icon="fa-sitemap" enable_counters="1"/>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='department_id']" position="before">
                <field name="project" icon="fa-sitemap" enable_counters="1"/>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="work_location_id" icon="fa-building-o" enable_counters="1"/>
            </xpath>
        </field>
    </record>

        <menuitem
            id="projects_nemu"
            name="Projects"
            parent="hr.menu_config_employee"
            action="sd_projects.project_window_action"/>
</odoo>
